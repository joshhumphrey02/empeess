# Copy this file to `.env` and fill in the values.

# PostgreSQL >= 15
DATABASE_URL="postgresql://user:password@localhost:5432/empeess"

APP_URL="http://localhost:3000"

# openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Ark (server-only token from Dashboard -> Apps)
ARK_BASE_URL="https://ark.nerdstackgrp.com/api/v2"
ARK_TOKEN=""

# ─── Paystack (payments) ─────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use sk_test_… while testing.
# Webhook URL to set there: <APP_URL>/api/paystack/webhook
PAYSTACK_SECRET_KEY=""

# ─── Email (password reset, verification, receipts, contact form) ────────────
# Resend API key (https://resend.com). Leave empty in development: emails are
# printed to the server log instead of being sent.
RESEND_API_KEY=""
# Sender, on a domain verified in Resend, e.g. "EMPEESS <orders@empeess.com>"
MAIL_FROM=""
# Where contact-form messages are forwarded (they are also in the dashboard).
CONTACT_INBOX=""
