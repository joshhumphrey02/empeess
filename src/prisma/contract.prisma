// use prisma-8

// Money is stored as integer minor units (e.g. kobo/cents) to avoid floating
// point rounding. `currency` is an ISO 4217 code.

types {
  Money = Int
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  @@type("pg/text@1")
  CUSTOMER = "CUSTOMER"
  // Dashboard access limited to the sections listed in `User.permissions`.
  STAFF    = "STAFF"
  ADMIN    = "ADMIN"
}

enum VerificationPurpose {
  @@type("pg/text@1")
  EMAIL_VERIFICATION = "EMAIL_VERIFICATION"
  PASSWORD_RESET     = "PASSWORD_RESET"
}

enum ProductStatus {
  @@type("pg/text@1")
  DRAFT    = "DRAFT"
  ACTIVE   = "ACTIVE"
  ARCHIVED = "ARCHIVED"
}

enum OrderStatus {
  @@type("pg/text@1")
  PENDING    = "PENDING"
  PAID       = "PAID"
  PROCESSING = "PROCESSING"
  SHIPPED    = "SHIPPED"
  DELIVERED  = "DELIVERED"
  CANCELLED  = "CANCELLED"
  REFUNDED   = "REFUNDED"
}

enum PaymentStatus {
  @@type("pg/text@1")
  PENDING  = "PENDING"
  SUCCESS  = "SUCCESS"
  FAILED   = "FAILED"
  REFUNDED = "REFUNDED"
}

// ─── Auth ────────────────────────────────────────────────────────────────────
// Email/password users carry a `passwordHash`; Google users get an `Account`
// row. A user can have both if they link Google to an email account.

model User {
  id              String             @id @default(uuid(7))
  email           String             @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt TimestamptzString?
  role            UserRole           @default(CUSTOMER)
  // Dashboard sections a STAFF user may open (see src/lib/permissions.ts).
  // Ignored for ADMIN (everything) and CUSTOMER (nothing).
  permissions     String[]           @default([])
  // Set when an admin bans the account: it can no longer sign in.
  bannedAt        TimestamptzString?

  // Profile picture: Ark asset id plus its permanent CDN url, or a Google
  // avatar url (no Ark id) for OAuth users.
  avatarArkId     String?
  avatarUrl       String?

  accounts        Account[]
  sessions        Session[]
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  wishlist        WishlistItem[]

  createdAt       TimestamptzString  @default(now())
  updatedAt       temporal.updatedAtString()
}

// OAuth provider link (Google). `provider` is a string so more providers can
// be added later without a migration.
model Account {
  id                String             @id @default(uuid(7))
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  scope             String?
  expiresAt         TimestamptzString?

  createdAt         TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Only a hash of the session token is stored; the raw token lives in the cookie.
model Session {
  id        String            @id @default(uuid(7))
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String            @unique
  expiresAt TimestamptzString
  userAgent String?
  ipAddress String?

  createdAt TimestamptzString @default(now())

  @@index([userId])
}

// One-time tokens for email verification and password reset.
model VerificationToken {
  id         String              @id @default(uuid(7))
  email      String
  purpose    VerificationPurpose
  tokenHash  String              @unique
  expiresAt  TimestamptzString
  consumedAt TimestamptzString?

  createdAt  TimestamptzString   @default(now())

  @@index([email, purpose])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────
// Categories are rows, not an enum, so new ones can be added from an admin
// screen. Seed: Clothes, Joggers, Hoodies, Perfumes.

model Category {
  id            String             @id @default(uuid(7))
  name          String             @unique
  slug          String             @unique
  description   String?
  sortOrder     Int                @default(0)
  isActive      Boolean            @default(true)

  imageArkId    String?
  imageUrl      String?

  products      Product[]

  createdAt     TimestamptzString  @default(now())
  updatedAt     temporal.updatedAtString()
}

model Product {
  id          String             @id @default(uuid(7))
  categoryId  String
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  slug        String             @unique
  description String?
  status      ProductStatus      @default(DRAFT)
  isFeatured  Boolean            @default(false)

  // Default price shown on listings; a variant may override it.
  basePrice   Money
  compareAtPrice Money?
  currency    String             @default("NGN")

  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]
  wishlistedBy WishlistItem[]

  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([categoryId, status])
}

// A purchasable unit. Clothes/joggers/hoodies vary by size and colour;
// perfumes vary by volume. Every product has at least one variant.
model ProductVariant {
  id         String             @id @default(uuid(7))
  productId  String
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String             @unique
  size       String?
  color      String?
  volumeMl   Int?
  price      Money?
  stock      Int                @default(0)
  isActive   Boolean            @default(true)

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt  TimestamptzString  @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([productId])
  @@check(expression: "stock >= 0", name: "product_variant_stock_non_negative")
}

// Image stored in Ark. Per Ark's docs, `url`, `thumbnailUrl` and
// `compressedUrl` are permanent CDN URLs and are safe to persist verbatim;
// `arkAssetId` is kept to delete or re-resolve the file later.
// `variantId` is set when an image belongs to a specific colour/variant.
model ProductImage {
  id            String             @id @default(uuid(7))
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)

  arkAssetId    String             @unique
  url           String
  thumbnailUrl  String?
  compressedUrl String?
  mimeType      String?
  size          Int?
  width         Int?
  height        Int?
  alt           String?
  position      Int                @default(0)

  createdAt     TimestamptzString  @default(now())

  @@index([productId, position])
  @@index([variantId])
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Address {
  id         String             @id @default(uuid(7))
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String?
  country    String             @default("NG")
  isDefault  Boolean            @default(false)

  createdAt  TimestamptzString  @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([userId])
}

model Review {
  id        String             @id @default(uuid(7))
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?

  createdAt TimestamptzString  @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([productId, userId])
  @@check(expression: "rating BETWEEN 1 AND 5", name: "review_rating_range")
}

model WishlistItem {
  id        String             @id @default(uuid(7))
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString  @default(now())

  @@unique([userId, productId])
}

// ─── Cart ────────────────────────────────────────────────────────────────────
// A cart belongs to a signed-in user, or to a guest identified by a cookie
// token; on sign-in the guest cart is merged into the user's.

model Cart {
  id         String             @id @default(uuid(7))
  userId     String?            @unique
  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?            @unique

  items      CartItem[]

  createdAt  TimestamptzString  @default(now())
  updatedAt  temporal.updatedAtString()
}

model CartItem {
  id        String             @id @default(uuid(7))
  cartId    String
  cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int                @default(1)

  createdAt TimestamptzString  @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([cartId, variantId])
  @@check(expression: "quantity > 0", name: "cart_item_quantity_positive")
}

// ─── Orders ──────────────────────────────────────────────────────────────────
// Orders snapshot product details and the shipping address so later catalog
// or address edits don't change past orders.

model Order {
  id               String             @id @default(uuid(7))
  orderNumber      String             @unique
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           OrderStatus        @default(PENDING)

  currency         String             @default("NGN")
  subtotal         Money
  shippingFee      Money              @default(0)
  discount         Money              @default(0)
  total            Money

  shippingFullName String
  shippingPhone    String
  shippingLine1    String
  shippingLine2    String?
  shippingCity     String
  shippingState    String
  shippingPostalCode String?
  shippingCountry  String
  note             String?

  items            OrderItem[]
  payments         Payment[]

  paidAt           TimestamptzString?
  shippedAt        TimestamptzString?
  deliveredAt      TimestamptzString?
  cancelledAt      TimestamptzString?
  createdAt        TimestamptzString  @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id           String          @id @default(uuid(7))
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable so deleting a variant doesn't erase order history.
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName  String
  variantLabel String?
  sku          String
  imageUrl     String?
  unitPrice    Money
  quantity     Int
  lineTotal    Money

  @@index([orderId])
  @@check(expression: "quantity > 0", name: "order_item_quantity_positive")
}

// Payment attempts against an order. `provider` is e.g. "paystack" or
// "stripe"; `reference` is the provider's transaction reference.
model Payment {
  id          String             @id @default(uuid(7))
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  reference   String             @unique
  status      PaymentStatus      @default(PENDING)
  amount      Money
  currency    String
  rawResponse Json?

  paidAt      TimestamptzString?
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([orderId])
}

// ─── Marketing & support ─────────────────────────────────────────────────────

// Footer newsletter sign-ups. Unsubscribing keeps the row (with a timestamp)
// so re-subscribing is a single update and we never mail someone who left.
model NewsletterSubscriber {
  id             String             @id @default(uuid(7))
  email          String             @unique
  unsubscribedAt TimestamptzString?

  createdAt      TimestamptzString  @default(now())
  updatedAt      temporal.updatedAtString()
}

// Messages from the contact page, read and resolved from the dashboard.
model ContactMessage {
  id        String             @id @default(uuid(7))
  name      String
  email     String
  subject   String?
  message   String
  orderNumber String?
  readAt    TimestamptzString?

  createdAt TimestamptzString  @default(now())

  @@index([createdAt])
}
